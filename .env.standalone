# MindPace 独立版本环境变量
# 部署到服务器时把这个文件复制为 .env.local 并填入真实值

# JWT 认证密钥（自定义一个安全的随机字符串）
JWT_SECRET=mindpace-standalone-secret-change-this-in-production

# 数据库连接（你自己的 PostgreSQL）
DATABASE_URL=postgresql://mindpace_user:Mindpace@2026@localhost:5432/mindpace_db

# 应用信息
NEXT_PUBLIC_APP_NAME=MindPace
NEXT_PUBLIC_APP_URL=http://123.207.40.7:3001
